# =============================================================================
# Electronic Butterfly — Environment Configuration Template
# Copy to .env and adjust values for your local environment
# =============================================================================

# --- Network & Web Server Settings ---
BUTTERFLY_HOST=0.0.0.0
BUTTERFLY_PORT=80
BUTTERFLY_DEV_PORT=8050

# --- Wi-Fi SoftAP Credentials ---
BUTTERFLY_SSID=CyberButterfly-ESP32
BUTTERFLY_PASS=cyberbutterfly

# --- Station Wi-Fi (Connect to your home/office network) ---
WIFI_STA_SSID=
WIFI_STA_PASS=

# --- Serial Flashing & Monitor (ESP32-C3) ---
UPLOAD_PORT=/dev/ttyACM0
MONITOR_SPEED=115200
