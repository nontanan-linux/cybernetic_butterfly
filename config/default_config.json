    "server": {
      "host": "0.0.0.0",
      "http_port": 80,
      "dev_port": 8050,
      "cors_enabled": true,
      "cors_origin": "*",
      "request_timeout_ms": 3000
    },
    "mdns": {
      "enabled": true,
      "hostname": "butterfly",
      "service_type": "_http",
      "protocol": "_tcp"
