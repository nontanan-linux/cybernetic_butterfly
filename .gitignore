# =============================================================================
# ElectronicsArt — Comprehensive .gitignore
# =============================================================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
build/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- PlatformIO / Embedded / Arduino ---
.pio/
.pioenvs/
.piolibdeps/
.clangd/
compile_commands.json
*.hex
*.bin
*.elf
*.o
*.a

# --- IDEs & Code Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System & Temporary Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp
*.temp
*.bak
*.log

# --- Local Secrets / Sensitive Overrides ---
.env
*.local.yaml
*.local.json
secrets.yaml
